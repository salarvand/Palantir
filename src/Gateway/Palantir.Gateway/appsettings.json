{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "iam-route": {
        "ClusterId": "iam-cluster",
        "Match": {
          "Path": "/api/v1/iam/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/iam/{**catch-all}" }
        ]
      },
      "oms-route": {
        "ClusterId": "oms-cluster",
        "Match": {
          "Path": "/api/v1/orders/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/orders/{**catch-all}" }
        ]
      },
      "engine-route": {
        "ClusterId": "engine-cluster",
        "Match": {
          "Path": "/api/v1/engine/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/engine/{**catch-all}" }
        ]
      },
      "external-route": {
        "ClusterId": "external-cluster",
        "Match": {
          "Path": "/api/v1/external/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/external/{**catch-all}" }
        ]
      },
      "risk-route": {
        "ClusterId": "risk-cluster",
        "Match": {
          "Path": "/api/v1/risk/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/risk/{**catch-all}" }
        ]
      },
      "market-route": {
        "ClusterId": "market-cluster",
        "Match": {
          "Path": "/api/v1/market/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/market/{**catch-all}" }
        ]
      },
      "market-hub-route": {
        "ClusterId": "market-cluster",
        "Match": {
          "Path": "/hubs/marketdata/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/hubs/marketdata/{**catch-all}" }
        ]
      },
      "portfolio-route": {
        "ClusterId": "portfolio-cluster",
        "Match": {
          "Path": "/api/v1/portfolio/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/portfolio/{**catch-all}" }
        ]
      },
      "settlement-route": {
        "ClusterId": "settlement-cluster",
        "Match": {
          "Path": "/api/v1/settlements/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/settlements/{**catch-all}" }
        ]
      },
      "audit-route": {
        "ClusterId": "audit-cluster",
        "Match": {
          "Path": "/api/v1/audit/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/audit/{**catch-all}" }
        ]
      },
      "ai-route": {
        "ClusterId": "ai-cluster",
        "Match": {
          "Path": "/mcp/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/mcp/{**catch-all}" }
        ]
      },
      "mock-exchange-route": {
        "ClusterId": "external-cluster",
        "Match": {
          "Path": "/mock-exchange/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/mock-exchange/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "iam-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://iam-service"
          }
        }
      },
      "oms-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://oms-service"
          }
        }
      },
      "engine-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://local-engine-service"
          }
        }
      },
      "external-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://external-gateway-service"
          }
        }
      },
      "market-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://market-data-service"
          }
        }
      },
      "risk-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://risk-service"
          }
        }
      },
      "portfolio-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://portfolio-service"
          }
        }
      },
      "settlement-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://settlement-service"
          }
        }
      },
      "audit-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://audit-service"
          }
        }
      },
      "ai-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://ai-assistant-service"
          }
        }
      }
    }
  }
}
