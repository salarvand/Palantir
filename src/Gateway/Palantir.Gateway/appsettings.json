{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "iam-route": {
        "ClusterId": "iam-cluster",
        "Match": {
          "Path": "/api/v1/iam/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/iam/{**catch-all}" }
        ]
      },
      "oms-route": {
        "ClusterId": "oms-cluster",
        "Match": {
          "Path": "/api/v1/orders/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/orders/{**catch-all}" }
        ]
      },
      "market-route": {
        "ClusterId": "market-cluster",
        "Match": {
          "Path": "/api/v1/market/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/market/{**catch-all}" }
        ]
      },
      "portfolio-route": {
        "ClusterId": "portfolio-cluster",
        "Match": {
          "Path": "/api/v1/portfolio/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/portfolio/{**catch-all}" }
        ]
      },
      "audit-route": {
        "ClusterId": "audit-cluster",
        "Match": {
          "Path": "/api/v1/audit/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/audit/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "iam-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://iam-service"
          }
        }
      },
      "oms-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://oms-service"
          }
        }
      },
      "market-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://market-data-service"
          }
        }
      },
      "portfolio-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://portfolio-service"
          }
        }
      },
      "audit-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://audit-service"
          }
        }
      }
    }
  }
}
