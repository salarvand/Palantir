<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Palantir.Platform</RootNamespace>
    <AssemblyName>Palantir.Platform</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Palantir.SharedKernel\Palantir.SharedKernel.csproj" />
    <ProjectReference Include="..\Palantir.Constants\Palantir.Constants.csproj" />
    <ProjectReference Include="..\Palantir.Generators.Abstractions\Palantir.Generators.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WolverineFx" />
    <PackageReference Include="WolverineFx.Http" />
    <PackageReference Include="WolverineFx.RabbitMQ" />
    <PackageReference Include="WolverineFx.Postgresql" />
    <PackageReference Include="WolverineFx.EntityFrameworkCore" />
    <PackageReference Include="WolverineFx.Marten" />
    <PackageReference Include="Marten" />
    <PackageReference Include="Microsoft.FeatureManagement.AspNetCore" />
    <PackageReference Include="Grpc.AspNetCore" />
